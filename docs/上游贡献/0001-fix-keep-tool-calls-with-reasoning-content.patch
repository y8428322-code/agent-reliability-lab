From 0bb09fe2b44f14c1763d2a72a015dc8ed797d44d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E6=9D=8E=E6=96=87=E5=BA=B7?=
 <16393472+dmulwk@user.noreply.gitee.com>
Date: Tue, 3 Nov 2026 09:06:28 +0800
Subject: [PATCH] fix(llm): keep tool_calls when a non-streaming reply also
 carries reasoning_content

In TextChatAtOAI._chat_no_stream the reply was dispatched on whether the
message has a reasoning_content attribute:

    if hasattr(response.choices[0].message, 'reasoning_content'):
        return [Message(role=ASSISTANT, content=..., reasoning_content=...)]
    else:
        return [Message(role=ASSISTANT, content=...)]

A reply that carries BOTH reasoning_content and tool_calls therefore lost
its tool calls, and the agent never performed the requested action. This
hits every endpoint that returns reasoning_content (MiniMax, DeepSeek-R1,
Qwen3-thinking, ...) as soon as use_raw_api/stream=False is used.

This patch keeps both: one message per tool call, mirroring the streaming
path (_chat_stream), with reasoning_content attached and extra.function_id
set to the provider's tool call id so that the ids stay unique.

Co-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>
---
 qwen_agent/llm/oai.py                    | 24 +++++--
 tests/llm/test_tool_call_preservation.py | 89 ++++++++++++++++++++++++
 2 files changed, 108 insertions(+), 5 deletions(-)
 create mode 100644 tests/llm/test_tool_call_preservation.py

diff --git a/qwen_agent/llm/oai.py b/qwen_agent/llm/oai.py
index 2498ef5..ec0da6f 100644
--- a/qwen_agent/llm/oai.py
+++ b/qwen_agent/llm/oai.py
@@ -166,14 +166,28 @@ class TextChatAtOAI(BaseFnCallModel):
         messages = self.convert_messages_to_dicts(messages)
         try:
             response = self._chat_complete_create(model=self.model, messages=messages, stream=False, **generate_cfg)
-            if hasattr(response.choices[0].message, 'reasoning_content'):
+            message = response.choices[0].message
+            reasoning_content = getattr(message, 'reasoning_content', None)
+            tool_calls = getattr(message, 'tool_calls', None) or []
+
+            if tool_calls:
+                # One message per tool call, mirroring the streaming path (_chat_stream):
+                # a reply may carry BOTH reasoning_content and tool_calls, and dropping
+                # the tool calls leaves the agent unable to act on the request.
                 return [
                     Message(role=ASSISTANT,
-                            content=response.choices[0].message.content,
-                            reasoning_content=response.choices[0].message.reasoning_content)
+                            content='',
+                            reasoning_content=reasoning_content,
+                            function_call=FunctionCall(name=tc.function.name, arguments=tc.function.arguments),
+                            extra={'function_id': tc.id})
+                    for tc in tool_calls
                 ]
-            else:
-                return [Message(role=ASSISTANT, content=response.choices[0].message.content)]
+
+            return [
+                Message(role=ASSISTANT,
+                        content=message.content,
+                        reasoning_content=reasoning_content)
+            ]
         except OpenAIError as ex:
             raise ModelServiceError(exception=ex)
 
