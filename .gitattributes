# 本项目在 Windows 上开发，但 scripts/*.sh 依赖 bash 执行。
# 本机 git 的 core.autocrlf=true 会把 LF 转成 CRLF，导致新克隆后 shell 脚本
# 出现 "bad interpreter: /usr/bin/env bash^M" 而无法执行，因此统一锁定 LF。
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
